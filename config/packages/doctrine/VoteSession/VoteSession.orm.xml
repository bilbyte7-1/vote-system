<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping
    xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://doctrine-project.org/schemas/orm/doctrine-mapping
        https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd"
>
    <entity
        name="App\Domain\VoteSession\VoteSession"
        table="vote_sessions"
    >
        <id
            name="voteSessionId"
            type="vote_session_id"
            column="id"
        >
            <generator strategy="NONE"/>
        </id>

        <field
            name="owner"
            type="owner_id"
            column="owner_id"
        />

        <field
            name="phase"
            type="string"
            column="phase"
            enum-type="App\Domain\VoteSession\Phase"
        />

        <field
            name="firstPhaseEndsAt"
            type="datetime_immutable"
            column="first_phase_ends_at"
        />

        <field
            name="secondPhaseEndsAt"
            type="datetime_immutable"
            column="second_phase_ends_at"
        />

        <field
            name="endedAt"
            type="datetime_immutable"
            column="ended_at"
            nullable="true"
        />
    </entity>
</doctrine-mapping>
